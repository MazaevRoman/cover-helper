[Unit]
Description=MD Helper — n8n markdown to blog HTML converter
After=network.target docker.service

[Service]
Type=simple
User=cloud4u
WorkingDirectory=/home/cloud4u/work/marketing-automation
Environment="HOME=/home/cloud4u"
Environment="PATH=/home/cloud4u/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NO_PROXY=localhost,127.0.0.1,172.17.0.1"
Environment="MD_TOKEN=__GENERATE_ME__"
Environment="MD_HOST=172.17.0.1"
Environment="MD_PORT=8082"
ExecStart=/home/cloud4u/work/marketing-automation/.venv/bin/python /home/cloud4u/work/marketing-automation/md-helper.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
